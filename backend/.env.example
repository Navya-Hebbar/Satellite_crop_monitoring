# Server
PORT=3001

# Gemini (AI reports)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Google Earth Engine (service account) ---
# Use ONE of the options below. Do not commit real keys to git.

# Option A (recommended): JSON key file OUTSIDE the repo
# GEE_CREDENTIALS_PATH=C:/Users/you/secrets/datavisual-gee-sa.json

# Option B: Standard Google env var (same JSON file)
# GOOGLE_APPLICATION_CREDENTIALS=C:/Users/you/secrets/datavisual-gee-sa.json

# Option C: Inline JSON in .env (escape quotes; keep on one line)
# GEE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"datavisual-494214",...}

# Legacy (still works if file exists): backend/gee-key.json
